rules_version = '2';

// This project (sunny-ship-437805-c5) is dedicated to this app only — unlike
// the shared signimage-cc project, these rules are safe to own and deploy
// from this repo without risk to any other app.
service firebase.storage {
  match /b/{bucket}/o {

    // Users can only read/write images under their own folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Shared sign library images: readable by any signed-in user, writable
    // only by the app owner.
    match /library/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'shansignimage1@gmail.com';
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
