rules_version = '2';

// This project (sunny-ship-437805-c5) is dedicated to this app only — unlike
// the shared signimage-cc project, these rules are safe to own and deploy
// from this repo without risk to any other app.
service firebase.storage {
  match /b/{bucket}/o {

    // Upload size caps (cost/abuse protection). Full-resolution site-photo
    // originals — kept only until "Finish measuring" — may be large (iPhone
    // ProRAW reaches ~75 MB). Everything else the app writes (4096 px working
    // images, thumbnails, dictation, project state, library art) is far
    // smaller, so it gets a tighter cap.
    function isCaptureOriginal() {
      return request.resource.name.matches('users/[^/]+/captures/[^/]+/[^/]+/original.*');
    }
    function withinUploadCap() {
      return request.resource.size < (isCaptureOriginal() ? 150 : 50) * 1024 * 1024;
    }

    // Users can only read/write files under their own folder
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && withinUploadCap();
    }

    // Shared sign library images: readable by signed-in users and writable by
    // users carrying the server-issued admin custom claim.
    match /library/{allPaths=**} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.token.admin == true;
      allow create, update: if request.auth != null
                            && request.auth.token.admin == true
                            && request.resource.size < 50 * 1024 * 1024;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
