{
  "name": "signagepro-mockup-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ipad": "playwright test --project=ipad",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "admin:claim": "node scripts/set-admin-claim.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@google/genai": "^1.30.0",
    "@sentry/react": "^10.69.0",
    "exifr": "^7.1.3",
    "firebase": "^12.6.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
